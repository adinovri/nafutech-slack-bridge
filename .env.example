# ==========================================================================
# Slack (required)
# ==========================================================================

# nanotech_bot bot token (xoxb-...) — from BW item NANOTECH_OAUTH_TOKEN
SLACK_BOT_TOKEN=xoxb-...

# App-level token for Socket Mode (xapp-...) — from BW item NANOTECH_APP_TOKEN.
# Scope: connections:write (Socket Mode).
SLACK_APP_TOKEN=xapp-...

# Sender filter — only messages AUTHORED by this Slack user trigger Claude.
# In channels: bot must be @-mentioned AND sender == this ID.
# In DM: any message from this ID to the bot triggers Claude.
# All other users are silently ignored.
TRIGGER_USER_ID=U051UM31HDF

# ==========================================================================
# Paths (edit if your layout differs; run_linux.sh / run_mac.sh assume these)
# ==========================================================================

# NafuTech workspace (claude CLI cwd; inherits its CLAUDE.md + memory + tools)
NAFUTECH_WORKSPACE=/home/scriberion/.openclaw/agents/nafutech/workspace

# Per-thread session storage (file-based)
THREAD_STORE_DIR=/home/scriberion/.openclaw/agents/nafutech/slack-threads

# Shared bg-task registry — bridge, nafu-bg-claude, and nafu-bg-watchdog
# ALL read/write this file. Change once, propagates everywhere.
BG_REGISTRY=/home/scriberion/.openclaw/bg_registry.json

# ==========================================================================
# Claude runtime
# ==========================================================================

# Path to claude CLI
CLAUDE_CLI=claude

# Claude model to use for runs
CLAUDE_MODEL=claude-sonnet-4-6

# Claude permission mode (bypassPermissions needed for non-interactive full-tools)
CLAUDE_PERMISSION_MODE=bypassPermissions

# Subprocess timeout per Claude run (seconds)
CLAUDE_TIMEOUT=600

# CLAUDE_CONFIG_DIR — where the claude CLI reads its OAuth creds + writes
# session transcripts. Resolution order (first wins):
#   1. systemd unit  → Environment=CLAUDE_CONFIG_DIR=... in deploy/systemd/*.service
#   2. THIS .env     → CLAUDE_CONFIG_DIR=... below (uncomment)
#   3. shell env     → export CLAUDE_CONFIG_DIR=... before running
#   4. default       → ~/.claude
# Multi-account setups (different agents on the same machine) usually pin
# this per-service in the systemd unit, not in .env. Leave commented out
# unless you're overriding for local dev.
# CLAUDE_CONFIG_DIR=/home/you/.claude

# ==========================================================================
# Optional — Telegram notify fallback for [bg] tasks
# ==========================================================================
# Only used when a bg task's notify target is "telegram" (the bridge always
# sends "slack" — these are for OTHER callers of nafu-bg / nafu-notify).
#
# Prefer putting these in ~/.config/nafutech-slack-bridge.env (mode 600)
# so they're not baked into a shared .env for the bridge itself. The watchdog
# systemd unit reads that file via EnvironmentFile=-.
#
# NAFU_TG_BOT_TOKEN=123456:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NAFU_TG_CHAT_ID=1234567890

LOG_LEVEL=INFO
